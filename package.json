{
  "name": "dyad-automation",
  "version": "1.0.0",
  "description": "AI-assisted Playwright automation framework for Nexsure, Alis Core, and Alis Custom.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:alis": "PLAYWRIGHT_BASE_URL=https://customer-alis.dyadtech.com/ALIS.BMS/APP/ playwright test --project=alis",
    "test:alis:login:headed": "PLAYWRIGHT_BASE_URL=https://customer-alis.dyadtech.com/ALIS.BMS/APP/ playwright test --project=alis alis/tests/login/login.test.ts --headed",
    "test:alis:header:headed": "PLAYWRIGHT_BASE_URL=https://customer-alis.dyadtech.com/ALIS.BMS/APP/ playwright test --project=alis alis/tests/header/header.test.ts --headed",
    "test:alis:create-submission:headed": "PLAYWRIGHT_BASE_URL=https://customer-alis.dyadtech.com/ALIS.BMS/APP/ playwright test --project=alis alis/tests/create-submission/create-submission.test.ts --headed",
    "test:alis:add-quote:headed": "PLAYWRIGHT_BASE_URL=https://customer-alis.dyadtech.com/ALIS.BMS/APP/ playwright test --project=alis alis/tests/add-quote/add-quote.test.ts --headed",
    "test:alis:market-selection:headed": "PLAYWRIGHT_BASE_URL=https://customer-alis.dyadtech.com/ALIS.BMS/APP/ playwright test --project=alis alis/tests/market-selection/market-selection.test.ts --headed",
    "test:alis:add-edit-risk:headed": "PLAYWRIGHT_BASE_URL=https://customer-alis.dyadtech.com/ALIS.BMS/APP/ playwright test --project=alis alis/tests/add-edit-risk/add-edit-risk.test.ts --headed",
    "test:alis:rate-summary:headed": "PLAYWRIGHT_BASE_URL=https://customer-alis.dyadtech.com/ALIS.BMS/APP/ playwright test --project=alis alis/tests/rate-summary/rate-summary.test.ts --headed",
    "test:alis:quote-option-details:headed": "PLAYWRIGHT_BASE_URL=https://customer-alis.dyadtech.com/ALIS.BMS/APP/ playwright test --project=alis alis/tests/quote-option-details/quote-option-details.test.ts --headed",
    "test:nexsure": "playwright test --project=nexsure",
    "test:nexsure:login:headed": "PLAYWRIGHT_BASE_URL=https://jmiqaweb01.nexsure.com/nexui/ playwright test --project=nexsure nexsure/tests/login/login.test.ts --headed",
    "test:nexsure:create-client:headed": "PLAYWRIGHT_BASE_URL=https://jmiqaweb01.nexsure.com/nexui/ playwright test --project=nexsure nexsure/tests/create_client/createClient.test.ts --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:shard": "playwright test --shard=${SHARD_INDEX}/${SHARD_TOTAL}",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "explore": "tsx agents/explorer-agent.ts",
    "generate:draft": "tsx agents/generator-agent.ts draft",
    "generate:spec": "tsx agents/generator-agent.ts generate",
    "triage": "tsx agents/triage-agent.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ankit-QAble/Dyad-Automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Ankit-QAble/Dyad-Automation/issues"
  },
  "homepage": "https://github.com/Ankit-QAble/Dyad-Automation#readme",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@napi-rs/canvas": "^0.1.80",
    "@types/pdf-parse": "^1.1.5",
    "gray-matter": "^4.0.3",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1",
    "yaml": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.5",
